# MealMitra AI - Supabase Cloud Configuration (Optional)
# If provided, the app will automatically switch from Local Demo Auth to live Supabase Auth & PostgreSQL.
# Copy this file to .env.local and populate with your Supabase Project settings.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
